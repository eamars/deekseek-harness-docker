# Required for model requests. The key can also be entered in Settings > Models.
DEEPSEEK_API_KEY=

# Pin the npm package version used by the image build.
DSH_VERSION=0.1.0-rc.6

# Keep this as 127.0.0.1 for local-only use. For a reverse proxy, set it to
# the exact public authority, for example: harness.example.com
DSH_TRUSTED_HOST=127.0.0.1
